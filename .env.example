# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=uofnotears
DB_USER=postgres
DB_PASSWORD=changeme

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# URLs (for Docker Compose)
CLIENT_URL=https://uofnotears.app
API_URL=https://uofnotears.app
CORS_ORIGIN=https://uofnotears.app

# Frontend (Vite build arg — leave empty for relative URLs via Caddy reverse proxy)
VITE_API_URL=

# ZeroSSL
ZEROSSL_EAB_KID=your_zerossl_eab_kid
ZEROSSL_EAB_HMAC_KEY=your_zerossl_eab_hmac_key
